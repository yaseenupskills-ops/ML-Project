# Copy to .env or export through your process manager. Never commit real values.
FALLGUARD_EMAIL_SENDER=
FALLGUARD_EMAIL_APP_PASSWORD=
FALLGUARD_EMAIL_RECIPIENT=
FALLGUARD_AUTH_SECRET=replace-with-a-long-random-secret
FALLGUARD_ENV=development

# Optional Streamlit development helper; leave false in production.
FALLGUARD_ALLOW_QUERY_TOKEN=false
FALLGUARD_SHOW_DEMO_ACCOUNTS=false
