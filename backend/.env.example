# Copy to .env and fill in real values. Never commit .env.

ENV=development

# Postgres (db service in docker-compose.yml)
POSTGRES_USER=fallguard
POSTGRES_PASSWORD=fallguard
POSTGRES_DB=fallguard
DATABASE_URL=postgresql+psycopg://fallguard:fallguard@db:5432/fallguard

# Auth (required, non-default, when ENV=production)
JWT_SECRET=changeme
CSRF_SECRET=changeme

CORS_ORIGINS=http://localhost:3000

# SMTP (mailhog in dev: host=mailhog, port=1025, no auth)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@fallguard.local
