# Fall Detection System — Config Template
# Copy this file to config.yaml and fill in your values.
# All hyperparameters can be tuned here without modifying source code.

# ─── Pose Extraction ──────────────────────────────────────────────────────────
pose:
  model_complexity: 0          # 0=fastest, 1=standard, 2=heavy
  frame_stride: 2              # Process every Nth frame (1=every frame, 2=half fps, etc.)
  smooth_window: 3             # Moving-average smoothing window (frames)
  min_confidence: 0.5          # Minimum mean keypoint visibility to keep a frame

# ─── Feature Engineering ──────────────────────────────────────────────────────
features:
  window_sec: 3.0              # Feature extraction window length (seconds)
  overlap: 0.5                 # Overlap fraction between consecutive windows (0.0–1.0)
  fps: 30                      # Expected input FPS (adjust per dataset/cam)

# ─── Decision Logic ───────────────────────────────────────────────────────────
decision:
  vote_windows: 3              # Consecutive high-confidence windows required for candidate
  high_conf: 0.80              # Confidence threshold for "high" tier
  low_conf: 0.50              # Below this = "low" tier (still reported but lower priority)

# ─── Grace Period ──────────────────────────────────────────────────────────────
grace_period:
  timeout_sec: 20              # Seconds before escalating alert after candidate detection

# ─── Email Alert (Gmail SMTP) ─────────────────────────────────────────────────
# Setup instructions:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail" → paste below
# 4. Recipient can be any email (doesn't need app password)
email:
  smtp_host: "smtp.gmail.com"
  smtp_port: 587
  sender: ""                   # Your Gmail address
  app_password: ""             # 16-char app password (not your regular password)
  recipient: ""                # Caretaker/family contact email
  subject_fallback: "⚠️ Fall Detection Alert"

# ─── Paths ────────────────────────────────────────────────────────────────────
paths:
  data_raw: "data/raw"
  data_processed: "data/processed"
  models_dir: "models"
  logs_dir: "logs"

# ─── Model ────────────────────────────────────────────────────────────────────
model:
  rf_path: "models/rf_baseline.joblib"
  cnn_lstm_path: "models/cnn_lstm.pt"  # Created only if CNN-LSTM phase is built
